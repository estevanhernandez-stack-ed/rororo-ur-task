<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>626labs.ur-task</AssemblyName>
    <RootNamespace>Labs626.UrTask</RootNamespace>
    <Version>0.2.3</Version>
    <Company>626 Labs LLC</Company>
    <Product>RoRoRo Ur Task</Product>
    <Description>Per-window-aware macro recording for RoRoRo-managed Roblox alts. Record on one account, refuse playback on any other.</Description>

    <!-- WPF on for the recorder window (task 9). Tray icon (task 10) uses
         Hardcodet.NotifyIcon.Wpf which is WPF-native — no WinForms needed. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- AllowUnsafeBlocks is required by the LibraryImport source generator
         (modern P/Invoke). Used in ForegroundWatcher and subsequent low-level
         hook + SendInput + RegisterHotKey calls in tasks 4–8. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests need access to the plugin's internal types (PluginClient,
         AccountRegistry, ForegroundWatcher, etc.). -->
    <InternalsVisibleTo Include="rororo-ur-task.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests/ directory has its own csproj. Excluding the source files
         here so the main project's implicit **/*.cs glob doesn't try to
         compile them as part of the EXE. -->
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin icon — surfaced on RoRoRo's consent sheet via manifest.json, on
         the WPF window chrome via Window.Icon, and on the system tray icon.
         v0.1 ships the generic 626 brand mark; v0.1.1 lands a custom-rendered
         icon following the vibe-X-square-1024 family pattern. -->
    <Resource Include="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.xaml lives under src/ rather than the project root; the default
         ApplicationDefinition glob only covers root-level *.xaml. Declare
         explicitly so the WPF SDK generates Main from it. -->
    <ApplicationDefinition Remove="**/App.xaml" />
    <ApplicationDefinition Include="src\App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
  </ItemGroup>

  <ItemGroup>
    <!-- The gRPC plugin contract, published from the ROROROblox repo to nuget.org. -->
    <PackageReference Include="ROROROblox.PluginContract" Version="0.1.0" />
  </ItemGroup>

</Project>
