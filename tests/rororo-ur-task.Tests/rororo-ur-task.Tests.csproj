<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>rororo-ur-task.Tests</AssemblyName>
    <RootNamespace>Labs626.UrTask.Tests</RootNamespace>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin under test. Pulls ROROROblox.PluginContract from nuget.org
         transitively, so the unit tests need nothing on disk but this repo. -->
    <ProjectReference Include="..\..\rororo-ur-task.csproj" />
  </ItemGroup>

  <!-- PluginClientIntegrationTests drives a real ROROROblox host via project
       references to the sibling repo's on-disk checkout (ROROROblox.App for the
       host plumbing: PluginHostStartupService, CapabilityInterceptor,
       PluginHostService, the registry interfaces). CI never checks that repo out,
       so a `-p:StandaloneTestsOnly=true` build drops both the host references AND
       the integration test file, leaving only tests that depend on the plugin +
       nuget contract. Local full runs (sibling repo present) keep everything. -->
  <ItemGroup Condition="'$(StandaloneTestsOnly)' != 'true'">
    <ProjectReference Include="..\..\..\ROROROblox\src\ROROROblox.App\ROROROblox.App.csproj" />
    <ProjectReference Include="..\..\..\ROROROblox\src\ROROROblox.PluginContract\ROROROblox.PluginContract.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(StandaloneTestsOnly)' == 'true'">
    <Compile Remove="PluginClientIntegrationTests.cs" />
  </ItemGroup>


  <ItemGroup>
    <None Include="..\fixtures\macro-v1.json">
      <Link>fixtures\macro-v1.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- NO XAML is copied to the test output on purpose. Copying the dialogs next to the test binary
       looked obvious and broke the build: this is a WPF project, its Page glob is `**/*.xaml`, and
       it happily re-compiled the copies out of tests\bin\ as a second set of pages — duplicate
       InitializeComponent, duplicate _contentLoaded, on every dialog.
       ModalDefaultButtonSafetyTests walks up to the repo root and reads src\UI\ directly instead,
       which is also what the host's XamlStyleScanner does. -->


</Project>
