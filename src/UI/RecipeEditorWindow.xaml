<Window x:Class="Labs626.UrTask.UI.RecipeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recipe editor"
        Icon="pack://application:,,,/icon.png"
        Width="820" Height="600"
        MinWidth="640" MinHeight="440"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource WhiteBrush}"
        FontFamily="{StaticResource BodyFont}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- title bar -->
                <RowDefinition Height="*" />    <!-- content -->
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  Height="36"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/icon.png"
                           Width="16" Height="16"
                           Margin="0,0,8,0" />
                    <TextBlock Text="RECIPE EDITOR"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="9"
                               Foreground="{DynamicResource CyanBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="✕"
                        Width="38"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource MutedTextBrush}"
                        FontSize="12"
                        Click="OnCloseClicked" />
            </Grid>

            <!-- Window content -->
            <Grid Grid.Row="1" Margin="20,4,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0: name field -->
                    <RowDefinition Height="*" />    <!-- 1: two panes -->
                    <RowDefinition Height="Auto" /> <!-- 2: footer -->
                </Grid.RowDefinitions>

                <!-- Row 0: recipe name -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="RECIPE NAME"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="9"
                               Foreground="{DynamicResource CyanBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource RowBgBrush}"
                             Foreground="{DynamicResource WhiteBrush}"
                             BorderBrush="{DynamicResource DividerBrush}"
                             BorderThickness="1"
                             Padding="8,6"
                             FontSize="12" />
                </StackPanel>

                <!-- Row 1: alt-set selection (left) + steps authoring (right) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left pane: alt-set selection -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource RowBgBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- header -->
                                <RowDefinition Height="Auto" /> <!-- select all/none -->
                                <RowDefinition Height="*" />    <!-- alt list -->
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="11,9,11,7">
                                <TextBlock Text="ALT SET"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="9"
                                           Foreground="{DynamicResource CyanBrush}" />
                            </Border>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="11,0,11,8"
                                        x:Name="AltPanel">
                                <Button Content="Select all"
                                        Click="SelectAllAlts_Click"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="9"
                                        Padding="9,5"
                                        Margin="0,0,6,0"
                                        Visibility="{Binding MultiSelect, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Select none"
                                        Click="SelectNoneAlts_Click"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="9"
                                        Padding="9,5"
                                        Visibility="{Binding MultiSelect, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                                <ItemsControl x:Name="AltList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,3"
                                                    CornerRadius="5"
                                                    BorderThickness="1"
                                                    Background="{DynamicResource BgBrush}"
                                                    Padding="10,8"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="OnAltRowClicked"
                                                    Tag="{Binding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="14" Height="14"
                                                            CornerRadius="3"
                                                            BorderThickness="1.5"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                                                                        <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayName}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Right pane: steps authoring -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource RowBgBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- header -->
                                <RowDefinition Height="Auto" /> <!-- add position step -->
                                <RowDefinition Height="Auto" /> <!-- set terminal -->
                                <RowDefinition Height="*" />    <!-- ordered steps list -->
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="11,9,11,7">
                                <TextBlock Text="STEPS"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="9"
                                           Foreground="{DynamicResource CyanBrush}" />
                            </Border>

                            <!-- Add position step -->
                            <Grid Grid.Row="1" Margin="11,0,11,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PositionMacroCombo"
                                          Grid.Column="0"
                                          Style="{StaticResource ThemedComboBox}"
                                          DisplayMemberPath="Name"
                                          Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Content="ADD POSITION STEP"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="9"
                                        Padding="9,5"
                                        Click="OnAddPositionStepClicked" />
                            </Grid>

                            <!-- Set terminal (loop / keep-alive) -->
                            <Grid Grid.Row="2" Margin="11,0,11,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="TerminalMacroCombo"
                                          Grid.Column="0"
                                          Style="{StaticResource ThemedComboBox}"
                                          DisplayMemberPath="Name"
                                          Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Content="SET LOOP"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="9"
                                        Padding="9,5"
                                        Margin="0,0,6,0"
                                        Click="OnSetLoopClicked" />
                                <Button Grid.Column="2"
                                        Content="SET KEEP-ALIVE"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="9"
                                        Padding="9,5"
                                        Margin="0,0,6,0"
                                        Click="OnSetKeepAliveClicked" />
                                <Button Grid.Column="3"
                                        Content="RUN ONCE"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="9"
                                        Padding="9,5"
                                        Click="OnSetDoneClicked" />
                            </Grid>

                            <!-- Ordered steps list -->
                            <Grid Grid.Row="3">
                            <TextBlock x:Name="EmptyStepsHint"
                                       Text="No steps yet — pick a macro and click ADD POSITION STEP, then SET LOOP or SET KEEP-ALIVE."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="20"
                                       Visibility="Collapsed" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                                <ItemsControl x:Name="StepsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,3"
                                                    CornerRadius="5"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource DividerBrush}"
                                                    Background="{DynamicResource BgBrush}"
                                                    Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="1"
                                                            Background="{DynamicResource RowBgBrush}"
                                                            BorderBrush="{DynamicResource CyanBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="6,2"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding IterationLabel}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="8"
                                                                   Foreground="{DynamicResource CyanBrush}" />
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Content="&#x25B2;"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{DynamicResource MutedTextBrush}"
                                                            FontSize="10"
                                                            Padding="4,0"
                                                            Visibility="{Binding IsPosition, Converter={StaticResource BoolToVisibility}}"
                                                            Click="OnMoveStepUpClicked" />
                                                    <Button Grid.Column="3"
                                                            Content="&#x25BC;"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{DynamicResource MutedTextBrush}"
                                                            FontSize="10"
                                                            Padding="4,0"
                                                            Visibility="{Binding IsPosition, Converter={StaticResource BoolToVisibility}}"
                                                            Click="OnMoveStepDownClicked" />
                                                    <Button Grid.Column="4"
                                                            Content="✕"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{DynamicResource MutedTextBrush}"
                                                            FontSize="11"
                                                            Padding="4,0"
                                                            Click="OnRemoveStepClicked" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 2: footer — validation text + Save/Run -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding ValidationError}"
                               FontSize="10"
                               Foreground="{DynamicResource MagentaBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="RUN"
                            Style="{StaticResource SecondaryButton}"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding CanSave}"
                            Click="OnRunClicked" />
                    <Button Grid.Column="2"
                            Content="SAVE"
                            Style="{StaticResource PrimaryButton}"
                            Padding="16,8"
                            IsEnabled="{Binding CanSave}"
                            Click="OnSaveClicked" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
