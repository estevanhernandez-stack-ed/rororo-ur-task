<Window x:Class="Labs626.UrTask.UI.RenameMacroDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename macro"
        Width="380" Height="180"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource WhiteBrush}"
        FontFamily="{StaticResource BodyFont}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True">
    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="Rename macro"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource WhiteBrush}"
                       Margin="0,0,0,12" />
            <TextBox x:Name="NameInput"
                     Grid.Row="1"
                     FontSize="13"
                     Padding="8,6"
                     Background="{DynamicResource RowBgBrush}"
                     Foreground="{DynamicResource WhiteBrush}"
                     BorderBrush="{DynamicResource DividerBrush}"
                     KeyDown="OnInputKeyDown" />
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <!-- RENAME KEEPS IsDefault, deliberately. This is a text-entry dialog: you type a
                     name and press Enter, and that is correct, expected behaviour — unlike the
                     Delete and Multi-window confirms, where Enter was doing the thing being
                     confirmed. The rule is "Enter must not perform the consequential action", not
                     "Enter must never do anything".
                     CANCEL only gains Esc, which it was missing — the dialog could not be
                     dismissed from the keyboard at all. -->
                <Button Content="CANCEL"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="OnCancel" />
                <Button Content="RENAME"
                        Padding="20,6"
                        Click="OnRename"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
