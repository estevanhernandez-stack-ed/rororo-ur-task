<Window x:Class="Labs626.UrTask.UI.MultiWindowConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-window playback"
        Width="420" Height="240"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource WhiteBrush}"
        FontFamily="{StaticResource BodyFont}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        KeyDown="OnKeyDown">
    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="MULTI-WINDOW MACRO"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="9"
                       Foreground="{DynamicResource CyanBrush}"
                       Margin="0,0,0,8" />
            <TextBlock Grid.Row="1"
                       FontSize="12"
                       TextWrapping="Wrap"
                       LineHeight="18"
                       Foreground="{DynamicResource WhiteBrush}">
                This macro plays back input across multiple windows as recorded. Make sure your alt windows are in their original positions and order. The macro will switch focus itself.
            </TextBlock>
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <!-- This dialog exists to make the user stop and look at how many windows a macro
                     is about to drive. Defaulting to PLAY defeats the thing it was built for: Enter
                     dismisses the warning by doing exactly what it warned about, into live game
                     clients. Nothing is destroyed here, so it is a softer case than DELETE — but a
                     confirmation that confirms itself is not a confirmation. -->
                <Button Content="CANCEL"
                        Style="{StaticResource SecondaryButton}"
                        Padding="16,6"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        IsCancel="True"
                        Click="OnCancel" />
                <Button Content="PLAY"
                        Style="{StaticResource PrimaryButton}"
                        Padding="20,6"
                        Click="OnPlay" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
