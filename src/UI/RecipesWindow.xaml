<Window x:Class="Labs626.UrTask.UI.RecipesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recipes"
        Icon="pack://application:,,,/icon.png"
        Width="560" Height="640"
        MinWidth="420" MinHeight="360"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource WhiteBrush}"
        FontFamily="{StaticResource BodyFont}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- title bar -->
                <RowDefinition Height="*" />    <!-- content -->
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  Height="36"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/icon.png"
                           Width="16" Height="16"
                           Margin="0,0,8,0" />
                    <TextBlock Text="RECIPES"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="9"
                               Foreground="{DynamicResource CyanBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="✕"
                        Width="38"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource MutedTextBrush}"
                        FontSize="12"
                        Click="OnCloseClicked" />
            </Grid>

            <!-- Window content -->
            <Grid Grid.Row="1" Margin="20,4,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0: header — label + NEW RECIPE -->
                    <RowDefinition Height="*" />    <!-- 1: recipe list -->
                </Grid.RowDefinitions>

                <!-- Row 0: header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="SAVED RECIPES"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="9"
                               Foreground="{DynamicResource CyanBrush}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="NEW RECIPE"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="9"
                            Padding="9,5"
                            Click="OnNewRecipeClicked" />
                </Grid>

                <!-- Row 1: recipe list -->
                <Grid Grid.Row="1">
                    <TextBlock x:Name="EmptyHint"
                               Text="No saved recipes yet. Click NEW RECIPE to make one."
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="20"
                               Visibility="Collapsed" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,4">
                        <ItemsControl x:Name="RecipeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            Background="{DynamicResource RowBgBrush}"
                                            Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource WhiteBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <!-- Type badge — LOADOUT (Done terminal: position steps run
                                                         once, then stop) vs RECIPE (Loop/KeepAlive terminal). -->
                                                    <Border Grid.Column="1"
                                                            Background="{DynamicResource RowBgBrush}"
                                                            BorderBrush="{DynamicResource CyanBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="5,1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeBadge}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="8"
                                                                   Foreground="{DynamicResource CyanBrush}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Summary}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="RUN"
                                                    Style="{StaticResource SecondaryButton}"
                                                    FontSize="9"
                                                    Padding="12,6"
                                                    Margin="10,0,6,0"
                                                    Click="OnRunClicked" />
                                            <Button Grid.Column="2"
                                                    Content="EDIT"
                                                    Style="{StaticResource SecondaryButton}"
                                                    FontSize="9"
                                                    Padding="12,6"
                                                    Margin="0,0,6,0"
                                                    Click="OnEditClicked" />
                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource MutedTextBrush}"
                                                    FontSize="12"
                                                    Padding="6,0"
                                                    ToolTip="Delete recipe"
                                                    Click="OnDeleteClicked" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
