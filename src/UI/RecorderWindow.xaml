<Window x:Class="Labs626.UrTask.UI.RecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoRoRo Ur Task"
        Icon="pack://application:,,,/icon.png"
        Width="860" Height="560"
        MinWidth="720" MinHeight="460"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource WhiteBrush}"
        FontFamily="{StaticResource BodyFont}"
        Topmost="{Binding IsTopmost}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="M" Modifiers="Control+Shift" Command="{Binding ToggleCompactCommand}" />
    </Window.InputBindings>

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- title bar -->
                <RowDefinition Height="*" />    <!-- content -->
            </Grid.RowDefinitions>

            <!-- Custom title bar. Pin + compact live here (not in the body) so
                 they stay reachable in compact mode, where the body collapses
                 to just the status pill. -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  Height="36"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/icon.png"
                           Width="16" Height="16"
                           Margin="0,0,8,0" />
                    <TextBlock Text="RORORO UR TASK"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="9"
                               Foreground="{DynamicResource CyanBrush}"
                               VerticalAlignment="Center" />
                    <Border Margin="10,0,0,0"
                            Padding="6,2"
                            CornerRadius="3"
                            Background="{DynamicResource RowBgBrush}"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsRecordModeAllWindows, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="MULTI-WINDOW"
                                   FontSize="8"
                                   Foreground="{DynamicResource CyanBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <Button Content="&#x1F4CC;"
                            Width="38"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource MutedTextBrush}"
                            FontSize="11"
                            ToolTip="Always on top"
                            Click="OnTogglePinClicked" />
                    <Button Content="&#x2310;"
                            Width="38"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource MutedTextBrush}"
                            FontSize="11"
                            ToolTip="Compact mode (Ctrl+Shift+M)"
                            Click="OnToggleCompactClicked" />
                    <Button Content="—"
                            Width="38"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource MutedTextBrush}"
                            FontSize="14"
                            Click="OnTitleBarMinimizeClicked" />
                    <Button Content="▢"
                            Width="38"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource MutedTextBrush}"
                            FontSize="11"
                            Click="OnTitleBarMaximizeClicked" />
                    <Button Content="✕"
                            Width="38"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource MutedTextBrush}"
                            FontSize="12"
                            Click="OnTitleBarCloseClicked" />
                </StackPanel>
            </Grid>

            <!-- Window content -->
            <Grid Grid.Row="1" Margin="20,4,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0: status pill (always visible — compact mode IS this row) -->
                    <RowDefinition Height="Auto" /> <!-- 1: action bar -->
                    <RowDefinition Height="*" />    <!-- 2: two panes -->
                    <RowDefinition Height="Auto" /> <!-- 3: footer -->
                </Grid.RowDefinitions>

                <!-- Row 0: status pill -->
                <Border Grid.Row="0"
                        Background="{DynamicResource RowBgBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource MagentaBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSequencePlaying}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunnerActive}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0"
                                 Width="8" Height="8"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Top">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource MagentaBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource CyanBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSequencePlaying}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource CyanBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRunnerActive}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource CyanBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding StatusLabel}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhiteBrush}" />
                            <TextBlock Text="{Binding StatusMeta}"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,2,0,0" />
                            <ProgressBar Margin="0,6,0,0"
                                         Height="3"
                                         Value="{Binding SequenceProgressFraction, Mode=OneWay}"
                                         Minimum="0"
                                         Maximum="1"
                                         Visibility="{Binding IsSequencePlaying, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1: action bar — record/abort/play left, arranging right -->
                <Grid Grid.Row="1"
                      Margin="0,12,0,0"
                      Visibility="{Binding IsNotCompact, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource PrimaryButton}"
                            Padding="18,8"
                            Command="{Binding RecordCommand}"
                            IsEnabled="{Binding IsNotPlaybackActive}">
                        <StackPanel>
                            <TextBlock Text="RECORD" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Ctrl+Shift+R" FontSize="9" Opacity="0.7" Margin="0,2,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryButton}"
                            Padding="18,8"
                            Command="{Binding StopCommand}">
                        <StackPanel>
                            <TextBlock Text="ABORT" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="Esc" FontSize="9" Opacity="0.7" Margin="0,2,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4"
                            Padding="18,8"
                            Command="{Binding TogglePlayStopCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <!-- Swap to outlined magenta when running so STOP visually
                                         distinguishes from PLAY (cyan fill vs magenta outline). -->
                                    <DataTrigger Binding="{Binding IsRunnerActive}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource MagentaBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource MagentaBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding PlayStopButtonLabel}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Ctrl+Shift+P · Esc" FontSize="9" Opacity="0.7" Margin="0,2,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="6"
                            Style="{StaticResource SecondaryButton}"
                            Padding="18,8"
                            ToolTip="Open your saved recipes (position steps → loop/keep-alive)"
                            Click="OnRecipesClicked">
                        <TextBlock Text="RECIPES" FontSize="12" HorizontalAlignment="Center" />
                    </Button>

                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="STACK"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Minimize all running alt windows (snapshots their positions first — RESET brings them back)"
                                FontSize="9"
                                Padding="9,5"
                                Margin="0,0,6,0"
                                Command="{Binding StackWindowsCommand}" />
                        <Button Content="GRID"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Tile all running alt windows in a grid to watch the round-robin"
                                FontSize="9"
                                Padding="9,5"
                                Margin="0,0,6,0"
                                Command="{Binding GridWindowsCommand}" />
                        <Button Content="RESET"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Restore alt windows to their positions from before STACK/GRID (and un-minimize)"
                                FontSize="9"
                                Padding="9,5"
                                Margin="0,0,6,0"
                                Command="{Binding RestoreWindowsCommand}" />
                        <Button Content="CLEAR"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Clear all macro-to-alt assignments"
                                FontSize="9"
                                Padding="9,5"
                                Command="{Binding ResetAssignmentsCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Row 2: two-pane dashboard — macros left, assignments + activity right -->
                <Grid Grid.Row="2"
                      Margin="0,12,0,0"
                      Visibility="{Binding IsNotCompact, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left pane: macro library -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource RowBgBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- header -->
                                <RowDefinition Height="Auto" /> <!-- recording toggles -->
                                <RowDefinition Height="*" />    <!-- list -->
                            </Grid.RowDefinitions>

                            <!-- Macros header: label + import/export -->
                            <Border Grid.Row="0" Padding="11,9,11,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="MACROS"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="9"
                                               Foreground="{DynamicResource CyanBrush}"
                                               VerticalAlignment="Center" />
                                    <!-- PLAYING NOW: hard-hide game-scoped macros for games no alt is
                                         running. All-games + unstamped macros always stay visible. -->
                                    <ToggleButton Grid.Column="1"
                                                  IsChecked="{Binding IsPlayingNowFilter, Mode=TwoWay}"
                                                  ToolTip="Show only macros for games your alts are playing right now (plus all-games macros)"
                                                  Cursor="Hand"
                                                  Margin="0,0,6,0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Chip"
                                                        Background="Transparent"
                                                        BorderBrush="{DynamicResource DividerBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="7,3">
                                                    <TextBlock x:Name="ChipText"
                                                               Text="PLAYING NOW"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="8"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                                        <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource CyanBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Button Grid.Column="2"
                                            Content="IMPORT"
                                            Style="{StaticResource SecondaryButton}"
                                            ToolTip="Import macros from a shared bundle file"
                                            FontSize="9"
                                            Padding="9,3"
                                            Margin="0,0,6,0"
                                            Click="OnImportMacrosClicked" />
                                    <Button Grid.Column="3"
                                            Content="EXPORT"
                                            Style="{StaticResource SecondaryButton}"
                                            ToolTip="Export all macros to a shareable bundle file"
                                            FontSize="9"
                                            Padding="9,3"
                                            IsEnabled="{Binding HasMacros}"
                                            Click="OnExportAllMacrosClicked" />
                                </Grid>
                            </Border>

                            <!-- Recording toggles -->
                            <Border Grid.Row="1"
                                    Padding="11,4,11,8"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsKeyboardOnlyRecording, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsNotPlaybackActive}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="Record keyboard only (recommended)"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Mouse events recorded — stack all alt windows at the same screen position for playback to land clicks correctly."
                                               FontSize="9"
                                               Foreground="{DynamicResource MagentaBrush}"
                                               TextWrapping="Wrap"
                                               Margin="22,4,0,0"
                                               Visibility="{Binding ShowMouseRecordingWarning, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsRecordModeAllWindows, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsNotPlaybackActive}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="Record across all windows"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="EXPERIMENTAL"
                                                   FontSize="8"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Macro list -->
                            <Grid Grid.Row="2">
                                <!-- Empty state -->
                                <TextBlock Text="Hit Ctrl+Shift+R or RECORD to capture your first macro"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="20"
                                           Visibility="{Binding HasNoMacros, Converter={StaticResource BoolToVisibility}}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasMacros, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding Macros}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Clicking the card marks it as the active assignment macro.
                                                     Local Background/BorderThickness removed so the Style triggers can take effect
                                                     (local values override triggers per WPF DP precedence). -->
                                                <Border Margin="6"
                                                        CornerRadius="6"
                                                        Padding="11,9"
                                                        Cursor="Hand"
                                                        MouseLeftButtonDown="OnMacroCardClicked">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="Background" Value="{DynamicResource BgBrush}" />
                                                            <Style.Triggers>
                                                                <!-- Active painter: thick cyan border + tinted background. -->
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource MacroIdEqualsCurrent}" Mode="OneWay">
                                                                            <Binding Path="Id" Mode="OneWay" />
                                                                            <Binding Path="DataContext.ActiveAssignmentMacroId"
                                                                                     RelativeSource="{RelativeSource AncestorType=Window}"
                                                                                     Mode="OneWay" />
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name, FallbackValue='(unnamed)'}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                            <!-- ⋯ overflow: Rename + Export + Delete -->
                                                            <Button Grid.Column="1"
                                                                    Content="&#x22EF;"
                                                                    FontSize="14"
                                                                    Foreground="{DynamicResource MutedTextBrush}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="6,0"
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Click="OnMacroOverflowClicked"
                                                                    Tag="{Binding}">
                                                                <Button.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="Rename" Click="OnMacroRenameClicked" Tag="{Binding}" />
                                                                        <MenuItem Header="Export…" Click="OnMacroExportClicked" Tag="{Binding}" />
                                                                        <MenuItem Header="Export as AutoHotkey">
                                                                            <MenuItem Header="v1…" Click="OnMacroExportAhkV1Clicked" Tag="{Binding}" />
                                                                            <MenuItem Header="v2…" Click="OnMacroExportAhkV2Clicked" Tag="{Binding}" />
                                                                        </MenuItem>
                                                                        <MenuItem Header="Allow in all games"
                                                                                  IsCheckable="True"
                                                                                  IsChecked="{Binding AllGames, Mode=OneWay}"
                                                                                  Click="OnMacroAllGamesClicked"
                                                                                  Tag="{Binding}" />
                                                                        <MenuItem Header="Delete" Click="OnMacroDeleteClicked" Tag="{Binding}" />
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                            </Button>
                                                        </Grid>
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock FontSize="9" Foreground="{DynamicResource MutedTextBrush}">
                                                                <Run Text="{Binding Events.Count, Mode=OneWay}" />
                                                                <Run Text="events" />
                                                            </TextBlock>
                                                            <TextBlock FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="10,0,0,0">
                                                                <Run Text="&#x00B7;" />
                                                                <Run Text="{Binding RecordedAgainstDisplayName, Mode=OneWay, FallbackValue='(any alt)'}" />
                                                            </TextBlock>
                                                            <!-- ACTIVE chip — visible when this card is the active assignment macro -->
                                                            <Border Background="{DynamicResource RowBgBrush}"
                                                                    BorderBrush="{DynamicResource CyanBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3"
                                                                    Padding="5,1"
                                                                    Margin="10,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Setter Property="Tag">
                                                                            <Setter.Value>
                                                                                <MultiBinding Converter="{StaticResource MacroIdEqualsCurrent}">
                                                                                    <Binding Path="Id" />
                                                                                    <Binding Path="DataContext.ActiveAssignmentMacroId"
                                                                                             RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                                </MultiBinding>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="Tag" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="ACTIVE"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="8"
                                                                           Foreground="{DynamicResource CyanBrush}" />
                                                            </Border>
                                                            <!-- Paired-alt chip — shows all current pairings simultaneously. -->
                                                            <Border Background="{DynamicResource BgBrush}"
                                                                    BorderBrush="{DynamicResource CyanBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3"
                                                                    Padding="5,1"
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <Border.Visibility>
                                                                    <MultiBinding Converter="{StaticResource PairedAltVisibility}" Mode="OneWay">
                                                                        <Binding Path="Id" Mode="OneWay" />
                                                                        <Binding Path="DataContext.PairedAltByMacroId"
                                                                                 RelativeSource="{RelativeSource AncestorType=Window}"
                                                                                 Mode="OneWay" />
                                                                    </MultiBinding>
                                                                </Border.Visibility>
                                                                <TextBlock FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="8"
                                                                           Foreground="{DynamicResource CyanBrush}">
                                                                    <Run Text="→ " />
                                                                    <Run>
                                                                        <Run.Text>
                                                                            <MultiBinding Converter="{StaticResource PairedAltForMacro}" Mode="OneWay">
                                                                                <Binding Path="Id" Mode="OneWay" />
                                                                                <Binding Path="DataContext.PairedAltByMacroId"
                                                                                         RelativeSource="{RelativeSource AncestorType=Window}"
                                                                                         Mode="OneWay" />
                                                                            </MultiBinding>
                                                                        </Run.Text>
                                                                    </Run>
                                                                </TextBlock>
                                                            </Border>
                                                            <!-- Game badge — where this macro was recorded. Absent =
                                                                 usable anywhere (all-games or pre-v0.6 macro). -->
                                                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3"
                                                                    Padding="5,1"
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RecordedGameName}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding AllGames}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding RecordedGameName}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="8"
                                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right pane: assignments (top) + activity (bottom) -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource RowBgBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- assignments header -->
                                <RowDefinition Height="*" />    <!-- assignment rows -->
                                <RowDefinition Height="Auto" /> <!-- activity header -->
                                <RowDefinition Height="150" />  <!-- activity log -->
                            </Grid.RowDefinitions>

                            <!-- Assignments header -->
                            <Border Grid.Row="0" Padding="11,9,11,7">
                                <StackPanel>
                                    <TextBlock Text="ASSIGNMENTS"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="9"
                                               Foreground="{DynamicResource CyanBrush}" />
                                    <TextBlock Text="Click a macro to mark it · click an alt row to assign · unassigned alts get keep-alive (Space)"
                                               FontSize="9"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap" />

                                    <!-- Routine (recipe/loadout) run strip — pick a saved routine, check
                                         which alts it runs on via the checkbox on each row below, hit RUN.
                                         Explicit selection only: no popup, nothing auto-wiped. -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  Style="{StaticResource ThemedComboBox}"
                                                  ItemsSource="{Binding SavedRoutines}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedRoutine, Mode=TwoWay}"
                                                  ToolTip="Pick a saved recipe or loadout to run"
                                                  Margin="0,0,8,0" />
                                        <Button Grid.Column="1"
                                                Command="{Binding ToggleRoutineRunCommand}"
                                                ToolTip="Run the selected routine on the checked alts below, or stop the active run (Ctrl+Shift+L)"
                                                Padding="14,6">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Style.Triggers>
                                                        <!-- Swap to outlined magenta while running, same treatment as
                                                             the PLAY/STOP toggle, so RUN vs STOP reads at a glance. -->
                                                        <DataTrigger Binding="{Binding IsRoutineRunning}" Value="True">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="Foreground" Value="{DynamicResource MagentaBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource MagentaBrush}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding RoutineRunButtonLabel}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                <TextBlock Text="Ctrl+Shift+L" FontSize="9" Opacity="0.7" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="target alts:"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="8"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Button Content="Select all"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding SelectAllRoutineAltsCommand}"
                                                FontSize="9"
                                                Padding="9,4"
                                                Margin="0,0,6,0" />
                                        <Button Content="Select none"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding SelectNoneRoutineAltsCommand}"
                                                FontSize="9"
                                                Padding="9,4" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Assignment rows -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Assignments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="6,3"
                                                    CornerRadius="5"
                                                    Padding="10,7"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="OnAssignmentRowClicked">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <!-- Active alt during cycle: cyan outline + tint so the row
                                                                 being played reads at a glance without window-hopping. -->
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource IntEquals}" Mode="OneWay">
                                                                        <Binding Path="Alt.Pid" Mode="OneWay" />
                                                                        <Binding Path="DataContext.CurrentRunnerAltPid"
                                                                                 RelativeSource="{RelativeSource AncestorType=Window}"
                                                                                 Mode="OneWay" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Routine-target checkbox — independent of the macro assignment
                                                         at right; both coexist on the same row. Handles its own click
                                                         (WPF marks the bubbling MouseLeftButtonDown Handled inside
                                                         ButtonBase), so it never also fires the row's
                                                         OnAssignmentRowClicked macro-assign toggle below. -->
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsCheckedForRoutine, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0"
                                                              ToolTip="Target this alt for the next routine RUN" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Alt.DisplayName}" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding DisplayMacroName}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Soft mismatch warning — macro recorded in a different game.
                                                             Advisory only; playback is never blocked. -->
                                                        <Border Background="{DynamicResource RowBgBrush}"
                                                                BorderBrush="{DynamicResource MagentaBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="6,2"
                                                                Margin="0,0,6,0"
                                                                ToolTip="{Binding GameMismatchHint}"
                                                                Visibility="{Binding HasGameMismatch, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="≠ GAME"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="8"
                                                                       Foreground="{DynamicResource MagentaBrush}"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Background="{DynamicResource RowBgBrush}"
                                                                BorderBrush="{DynamicResource CyanBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="6,2"
                                                                Visibility="{Binding HasMacro, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="ASSIGNED"
                                                                       FontSize="8"
                                                                       Foreground="{DynamicResource CyanBrush}"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Activity header -->
                            <Border Grid.Row="2"
                                    Padding="11,8,11,4"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,1,0,0">
                                <TextBlock Text="ACTIVITY"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="9"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </Border>

                            <!-- Activity log -->
                            <ListBox Grid.Row="3"
                                     ItemsSource="{Binding StatusLines}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource MutedTextBrush}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="10"
                                     BorderThickness="0"
                                     Margin="4,0,4,4"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,2" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 3: footer -->
                <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,8,0,0"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding IsNotCompact, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ConnectionLabel}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="9"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
