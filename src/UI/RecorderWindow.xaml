<Window x:Class="Labs626.UrTask.UI.RecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoRoRo Ur Task"
        Icon="pack://application:,,,/icon.png"
        Width="520" Height="640"
        MinWidth="440" MinHeight="520"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource WhiteBrush}"
        FontFamily="{StaticResource BodyFont}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- header -->
            <RowDefinition Height="Auto" /> <!-- foreground bind display -->
            <RowDefinition Height="Auto" /> <!-- state pill -->
            <RowDefinition Height="Auto" /> <!-- buttons -->
            <RowDefinition Height="Auto" /> <!-- last macro -->
            <RowDefinition Height="*" />    <!-- macros list -->
            <RowDefinition Height="Auto" /> <!-- log header -->
            <RowDefinition Height="120" />  <!-- log list -->
            <RowDefinition Height="Auto" /> <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="RORORO UR TASK"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="10"
                       Foreground="{StaticResource CyanBrush}" />
            <TextBlock Text="Per-window macros for RoRoRo-managed alts."
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="20"
                       Foreground="{StaticResource WhiteBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Foreground bind display -->
        <Border Grid.Row="1"
                Background="{StaticResource RowBgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,12">
            <StackPanel>
                <TextBlock Text="FOREGROUND WINDOW" Style="{StaticResource MetaLabel}" />
                <TextBlock Text="{Binding BoundForegroundLabel}"
                           FontSize="14"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- State pill -->
        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="14,10"
                CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource RowBgBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource MagentaBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="STATE" Style="{StaticResource MetaLabel}" />
                <TextBlock Text="{Binding StateLabel}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Command="{Binding RecordCommand}">
                <StackPanel>
                    <TextBlock Text="RECORD" />
                    <TextBlock Text="F8" FontSize="9" Opacity="0.7" Margin="0,2,0,0" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding PlayCommand}">
                <StackPanel>
                    <TextBlock Text="PLAY LAST" />
                    <TextBlock Text="F5" FontSize="9" Opacity="0.7" Margin="0,2,0,0" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Command="{Binding StopCommand}">
                <StackPanel>
                    <TextBlock Text="ABORT" />
                    <TextBlock Text="Esc" FontSize="9" Opacity="0.7" Margin="0,2,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Last macro -->
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="LAST RECORDED" Style="{StaticResource MetaLabel}" />
            <TextBlock Text="{Binding LastMacroLabel}"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Macros list -->
        <Border Grid.Row="5"
                Margin="0,14,0,0"
                Background="{StaticResource RowBgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <ListBox ItemsSource="{Binding Macros}"
                     Background="Transparent"
                     Foreground="{StaticResource WhiteBrush}"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,6">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding Events.Count, Mode=OneWay}" />
                                <Run Text="events · bound to " />
                                <Run Text="{Binding BoundDisplayName, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Log header -->
        <TextBlock Grid.Row="6"
                   Text="ACTIVITY"
                   Style="{StaticResource MetaLabel}"
                   Margin="0,14,0,0" />

        <!-- Log -->
        <Border Grid.Row="7"
                Margin="0,4,0,0"
                Background="{StaticResource RowBgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <ListBox ItemsSource="{Binding StatusLines}"
                     Background="Transparent"
                     Foreground="{StaticResource MutedTextBrush}"
                     FontFamily="{StaticResource MonoFont}"
                     FontSize="10"
                     BorderThickness="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Footer / connection -->
        <Border Grid.Row="8" Margin="0,14,0,0" Padding="0,8,0,0"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding ConnectionLabel}"
                       Style="{StaticResource MetaLabel}" />
        </Border>
    </Grid>
</Window>
